---
/**
 * AcidBanner — the canonical 4DK closing banner block.
 *
 * Composition preserved. Unverified bitmap artwork was replaced on owner
 * instruction for the 2026-10-11 release; see docs/MEDIA_RELEASE_2026-10-11.md.
 */
import { bannerAssets } from '../lib/assets';
---

<section class="w1-banner" aria-label="4DK">
  <img src={bannerAssets.footerLeft} alt="" width="350" height="141" loading="lazy" decoding="async" />
  <div class="w1-banner__m">Food intelligence<br />for real life.</div>
  <div class="w1-banner__brand">4DK.</div>
  <div class="w1-banner__m">Real food.<br />Real people.</div>
  <img src={bannerAssets.footerRight} alt="" width="442" height="141" loading="lazy" decoding="async" />
</section>

<style>
  .w1-banner {
    background: var(--acid);
    color: var(--ink);
    display: grid;
    grid-template-columns: 22% 13% 29% 13% 23%;
    align-items: center;
    overflow: hidden;
    min-height: 155px;
  }
  .w1-banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .w1-banner__brand {
    font-weight: 950;
    font-size: 72px;
    letter-spacing: -0.07em;
    text-align: center;
    line-height: 1;
  }
  .w1-banner__m {
    font: 800 11px/1.4 var(--mono);
    text-transform: uppercase;
  }
  @media (max-width: 600px) {
    .w1-banner {
      grid-template-columns: 25% 50% 25%;
    }
    .w1-banner__m {
      display: none;
    }
    .w1-banner__brand {
      font-size: 12vw;
    }
  }
</style>
