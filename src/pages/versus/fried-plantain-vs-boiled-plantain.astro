---
// /versus/fried-plantain-vs-boiled-plantain/ — C3 social extension (Stage 11).
// REFERENCE: 4DK_Stage11_C3_Social_Extensions_v2_FightHero
// fried-vs-boiled-plantain.html (verbatim port; c3-social-extension-template
// is the reusable template system, not a launch route).
// Locked rule honored: the vote mechanic stays clearly-local (localStorage) —
// no fake global counts, no fabricated votes or comments shipped.
import Base from '../../layouts/Base.astro';
import raw from '../../page-artifacts/versus-plantain.html?raw';
import { portArtifact } from '../../lib/port';
import { MARKETING_CTA_HREF, CANONICAL_ASSETS } from '../../lib/artifact-links';
import { insertNavAfterBrand, LOGO_ONLY_NAV_CSS } from '../../lib/feature-pages';

// W9-R1: locked five-item primary nav inserted into the approved logo-only
// header (composition preserved; nav hidden < 900px). The artifact's only
// dead link is the topbar logo stub — wire it home.
const withNav = insertNavAfterBrand(raw);

const ported = portArtifact(withNav, {
  canonicalAssets: CANONICAL_ASSETS,
  assetPrefix: '/assets/pages/versus',
  appendCss: LOGO_ONLY_NAV_CSS,
  rawReplaces: [['href="#"', 'href="/"']],
  ctaHrefs: MARKETING_CTA_HREF,
});
---

<Base routeKey="versus-plantain">
  <style is:global set:html={ported.css} />
  <Fragment set:html={ported.body} />
  {ported.scripts.map((js) => <script is:inline set:html={js} />)}
</Base>
