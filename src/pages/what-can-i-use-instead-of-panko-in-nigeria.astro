---
// /what-can-i-use-instead-of-panko-in-nigeria/ — Food Intelligence sample (Stage 7).
// Archetype: local substitution (Ask + Location Engine bridge).
// REFERENCE: 4DK_First_Content_Program_Samples_v1 (verbatim port).
import Base from '../layouts/Base.astro';
import raw from '../page-artifacts/intelligence-panko-nigeria.html?raw';
import { portArtifact } from '../lib/port';
import { CONTENT_LINK_REWRITES, MARKETING_CTA_HREF, CANONICAL_ASSETS } from '../lib/artifact-links';
import { lockedNavReplace } from '../lib/feature-pages';

const ported = portArtifact(raw, {
  canonicalAssets: CANONICAL_ASSETS,
  assetPrefix: '/assets/pages/content',
  rawReplaces: [lockedNavReplace('content.html')],
  linkRewrites: CONTENT_LINK_REWRITES,
  ctaHrefs: MARKETING_CTA_HREF,
});
---

<Base routeKey="content-local-substitution" artifactSchema={ported.headJsonLd}>
  <style is:global set:html={ported.css} />
  <Fragment set:html={ported.body} />
  {ported.scripts.map((js) => <script is:inline set:html={js} />)}
</Base>
