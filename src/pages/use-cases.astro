---
// /use-cases/ — C1 Conversion Hub (route selector, Stage 5 batch launcher).
// REFERENCE: 4DK_C1_Conversion_Landing_Batch_v7_Audited index.html (verbatim port).
// Approved behavior preserved: grid view ↔ scroll-driven list view switch,
// wheel indicator, preview card, route meta — all four selector targets are
// the production C1 routes. Not one of the 29 approved indexable routes:
// noindex + excluded from sitemap (selector utility, W3 instruction).
import Base from '../layouts/Base.astro';
import raw from '../page-artifacts/c1-hub.html?raw';
import { portArtifact } from '../lib/port';
import { CTA, LEGACY_BETA_MAILTO } from '../lib/cta';
import { CANONICAL_ASSETS } from '../lib/artifact-links';
const ported = portArtifact(raw, {
  canonicalAssets: CANONICAL_ASSETS,
  assetPrefix: '/assets/pages/c1',
  // W7: the floating view-switch pill sits outside the hub's own <main> —
  // give it an explicit labelled region so all content is landmarked.
  rawReplaces: [
    ['<div class="view-switch" aria-label="Change view">', '<div class="view-switch" role="region" aria-label="Change view">'],
  ],
  linkRewrites: {
    'what-should-i-cook-tonight.html': '/what-should-i-cook-tonight/',
    'use-it-before-it-goes-bad.html': '/use-it-before-it-goes-bad/',
    'scan-my-kitchen.html': '/scan-my-kitchen/',
    'steal-a-recipe.html': '/steal-a-recipe/',
  },
  ctaHrefs: { [LEGACY_BETA_MAILTO]: CTA.startCooking.href },
});
---

<Base routeKey="c1-hub">
  <style is:global set:html={ported.css} />
  <Fragment set:html={ported.body} />
  {ported.scripts.map((js) => <script is:inline set:html={js} />)}
</Base>
