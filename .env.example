# Host-aware configuration for the 4DK website.
# Copy to .env (local) or set in the CI/deploy environment.

# Canonical origin baked into canonical URLs, sitemap and schema.
# Production default: https://get4dk.com
CANONICAL_ORIGIN=https://get4dk.com

# Deployment surface: production | beta | local
#   production → indexable
#   beta       → noindex enforced (beta.get4dk.com must never compete in search)
#   local      → dev server default (noindex)
PUBLIC_SITE_ENV=production

# Escape hatch: force noindex on any build regardless of env.
PUBLIC_FORCE_NOINDEX=false
