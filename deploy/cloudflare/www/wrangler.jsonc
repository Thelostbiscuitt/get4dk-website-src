// Canonical HTTPS redirect for www and plain HTTP on the marketing host.
// Deploy (from this directory):  npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "get4dk-www-redirect",
  "compatibility_date": "2026-09-30",
  "main": "worker.js",
  "routes": [
    { "pattern": "www.get4dk.com", "custom_domain": true },
    { "pattern": "http://get4dk.com/*", "zone_name": "get4dk.com" }
  ],
  "observability": { "enabled": false }
}
